# Copy to scripts/e2e/base-sepolia/e2e.env and fill before running.

# Git / PR context
E2E_GIT_REMOTE=origin
E2E_GIT_BASE_BRANCH=main
AUTOPILOT_GITHUB_REPOSITORY=owner/repo
AUTOPILOT_GITHUB_TOKEN=

# Base Sepolia RPC + signer used for deploy/sync
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=0x

# ChampionRegistry deployment args
# CHAMPION_REGISTRY_OWNER defaults to the DEPLOYER_PRIVATE_KEY address if omitted.
CHAMPION_REGISTRY_OWNER=
CHAMPION_LINEAGE_ARCHIVE_ROOT=0x1111111111111111111111111111111111111111111111111111111111111111
CHAMPION_PROVENANCE_ARCHIVE_ROOT=0x2222222222222222222222222222222222222222222222222222222222222222

# Provenance signing keys (PEM files)
E2E_SIGNING_PRIVATE_KEY_FILE=
E2E_SIGNING_PUBLIC_KEY_FILE=

# Agent env files used for behavioral baseline/challenger generation
E2E_AGENT_BASELINE_ENV_PATH=apps/agent/.env
E2E_AGENT_CANDIDATE_ENV_PATH=apps/agent/.env
E2E_AGENT_WAIT_SECONDS=180
E2E_AGENT_MIN_RUN_LINES=1
E2E_AGENT_INTERVAL_SECONDS=20

# Autopilot staging mode
AUTOPILOT_PHASE=3
AUTOPILOT_PR_MODE=execute
AUTOPILOT_REQUIRE_HUMAN_APPROVAL=false

# Optional output override (relative to repo root if not absolute)
E2E_REPORT_DIR=autonomy/reports/e2e/base-sepolia
