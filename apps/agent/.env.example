# Required RPCs
BASE_RPC_URL=https://mainnet.base.org
# Pimlico public bundler endpoint (Base mainnet)
BUNDLER_RPC_URL=https://public.pimlico.io/v2/8453/rpc
# Base Sepolia alternative:
# BUNDLER_RPC_URL=https://public.pimlico.io/v2/84532/rpc
PAYMASTER_RPC_URL=

# Chain/runtime
CHAIN_ID=8453
ALLOW_TESTNET=false
DRY_RUN=true

# ERC-4337
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
ENTRYPOINT_VERSION=0.7
# Base default for EntryPoint v0.7 SimpleAccountFactory (override if your bundler/paymaster requires another)
FACTORY_ADDRESS=0x91E60e0613810449d098b0b5Ec8b51A0FE8c8985
OWNER_PRIVATE_KEY=0x
SMART_ACCOUNT_SALT=0

# Base Builder Code (ERC-8021)
BUILDER_CODE=bc_your_builder_code

# Policy knobs
HF_TARGET=1.60
HF_BUFFER=0.10
MAX_LOOPS=5
LOOP_BORROW_BPS=3500
RUN_INTERVAL_SECONDS=60
SLIPPAGE_BPS=100
RISK_ENGINE_MODE=aave-wsteth
RISK_MONTE_CARLO_PATHS=10000
RISK_MONTE_CARLO_HORIZON_DAYS=30
# Set for deterministic replay in CI/debug.
# RISK_MONTE_CARLO_SEED=42

# Compute runway + escrow
# Supported modes: escrow | conway | alchemy
COMPUTE_BILLING_MODE=escrow
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
MONTHLY_SERVER_COST_USDC=7.50
COMPUTE_BUFFER_BPS=2000
RUNWAY_NOMINAL_DAYS=14
RUNWAY_ELEVATED_DAYS=7
RUNWAY_DEAD_DAYS=2
MAX_HARVEST_EQUITY_BPS=500

# Conway credits + x402 (used when COMPUTE_BILLING_MODE=conway)
CONWAY_API_BASE_URL=
CONWAY_API_KEY=
CONWAY_CREDITS_BALANCE_PATH=/v1/credits/balance
CONWAY_CREDITS_TOPUP_PATH=/pay
# Optional recipient for onchain USDC transfers when using conway mode.
# If unset, escrow address is used as the transfer recipient.
CONWAY_PAYMENT_RECIPIENT_ADDRESS=
# Conway payer wallet relay (derived automatically from CONWAY_PAYER_PRIVATE_KEY if unset)
CONWAY_PAYER_ADDRESS=
CONWAY_X402_ENABLED=true
CONWAY_PAYER_PRIVATE_KEY=
CONWAY_X402_HEADER_NAME=x-payment
CONWAY_FALLBACK_TO_ESCROW_ON_ERROR=true
CONWAY_CREDITS_MIN_BALANCE_USDC=10
CONWAY_CREDITS_TARGET_BALANCE_USDC=50
CONWAY_CREDITS_MAX_TOPUP_USDC_PER_TICK=25
CONWAY_CREDITS_TOPUP_COOLDOWN_SECONDS=900
CONWAY_PAYER_MIN_BALANCE_USDC=5
CONWAY_PAYER_TARGET_BALANCE_USDC=25
CONWAY_PAYER_MAX_FUND_USDC_PER_TICK=25
CONWAY_PAYER_MAX_FUND_USDC_PER_DAY=100
CONWAY_PAYER_FUND_COOLDOWN_SECONDS=900
CONWAY_RECONCILIATION_BOOTSTRAP_USDC=0
CONWAY_RECONCILIATION_WINDOW_HOURS=24

# Alchemy credits + x402 (used when COMPUTE_BILLING_MODE=alchemy)
# These keys map into the same runtime controls used by Conway mode.
ALCHEMY_API_BASE_URL=
ALCHEMY_API_KEY=
ALCHEMY_CREDITS_BALANCE_PATH=/v1/credits/balance
ALCHEMY_CREDITS_TOPUP_PATH=/pay
ALCHEMY_PAYMENT_RECIPIENT_ADDRESS=
ALCHEMY_PAYER_ADDRESS=
ALCHEMY_PAYER_PRIVATE_KEY=
ALCHEMY_X402_ENABLED=true
ALCHEMY_X402_HEADER_NAME=payment-signature
ALCHEMY_FALLBACK_TO_ESCROW_ON_ERROR=true

# Onchain integrations (Base mainnet defaults shown)
WSTETH_ADDRESS=0xc1CBa3fCea344f92D9239c08C0568f6F2F0ee452
WETH_ADDRESS=0x4200000000000000000000000000000000000006
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_DECIMALS=6
AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
DEX_ROUTER_ADDRESS=0x2626664c2603336E57B271c5C0b26F421741e481

# Base Sepolia override hints:
# CHAIN_ID=84532
# ALLOW_TESTNET=true
# USDC_DECIMALS=6
# AAVE_POOL_ADDRESS=0x8bAB6d1b75f19e9eD9fCe8b9BD338844fF79aE27

# 0x swap API
ZEROX_API_URL=https://base.api.0x.org/swap/allowance-holder/quote
ZEROX_API_KEY=

# Local persistence
RUN_LOG_PATH=./data/runs.ndjson
SNAPSHOT_PATH=./data/wsteth-snapshots.json
SWAP_COST_USD_ESTIMATE=0

# Runtime provenance tags (for attestation traceability)
AGENT_VERSION=0.1.0
AUTOPILOT_VERSION=manual
AUTOPILOT_MODEL_ID=unspecified
AUTOPILOT_POLICY_VERSION=1
AUTOPILOT_COMMIT_SHA=unknown

# Dashboard telemetry (optional, no-ops if unset)
DASHBOARD_INGEST_URL=
INGEST_SECRET=
