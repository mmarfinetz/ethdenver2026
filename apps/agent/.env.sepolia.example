# Base Sepolia demo profile (copy to .env.sepolia.local and fill secrets)

# Required RPCs
BASE_RPC_URL=https://base-sepolia-rpc.publicnode.com
BUNDLER_RPC_URL=https://public.pimlico.io/v2/84532/rpc
PAYMASTER_RPC_URL=

# Chain/runtime
CHAIN_ID=84532
ALLOW_TESTNET=true
DRY_RUN=true

# ERC-4337
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
ENTRYPOINT_VERSION=0.7
FACTORY_ADDRESS=0x91E60e0613810449d098b0b5Ec8b51A0FE8c8985
OWNER_PRIVATE_KEY=0x
SMART_ACCOUNT_SALT=0

# Builder attribution
BUILDER_CODE=bc_demo_builder_code

# Policy knobs
HF_TARGET=1.60
HF_BUFFER=0.10
MAX_LOOPS=5
LOOP_BORROW_BPS=3500
RUN_INTERVAL_SECONDS=60
SLIPPAGE_BPS=100
RISK_ENGINE_MODE=aave-wsteth
RISK_MONTE_CARLO_PATHS=10000
RISK_MONTE_CARLO_HORIZON_DAYS=30

# Compute runway + escrow (demo default)
COMPUTE_BILLING_MODE=escrow
# Set this to your own wallet for demo compute topups.
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
MONTHLY_SERVER_COST_USDC=7.50
COMPUTE_BUFFER_BPS=2000
RUNWAY_NOMINAL_DAYS=14
RUNWAY_ELEVATED_DAYS=7
RUNWAY_DEAD_DAYS=2
MAX_HARVEST_EQUITY_BPS=500

# Conway credits + x402 (only used when COMPUTE_BILLING_MODE=conway)
CONWAY_API_BASE_URL=
CONWAY_API_KEY=
CONWAY_CREDITS_BALANCE_PATH=/v1/credits/balance
CONWAY_CREDITS_TOPUP_PATH=/v1/credits/topup
CONWAY_PAYMENT_RECIPIENT_ADDRESS=
CONWAY_PAYER_ADDRESS=
CONWAY_X402_ENABLED=true
CONWAY_PAYER_PRIVATE_KEY=
CONWAY_X402_HEADER_NAME=x-payment
CONWAY_FALLBACK_TO_ESCROW_ON_ERROR=true
CONWAY_CREDITS_MIN_BALANCE_USDC=10
CONWAY_CREDITS_TARGET_BALANCE_USDC=50
CONWAY_CREDITS_MAX_TOPUP_USDC_PER_TICK=25
CONWAY_CREDITS_TOPUP_COOLDOWN_SECONDS=900
CONWAY_PAYER_MIN_BALANCE_USDC=5
CONWAY_PAYER_TARGET_BALANCE_USDC=25
CONWAY_PAYER_MAX_FUND_USDC_PER_TICK=25
CONWAY_PAYER_MAX_FUND_USDC_PER_DAY=100
CONWAY_PAYER_FUND_COOLDOWN_SECONDS=900
CONWAY_RECONCILIATION_BOOTSTRAP_USDC=0
CONWAY_RECONCILIATION_WINDOW_HOURS=24

# Onchain integrations (Base Sepolia defaults)
# Aave Base Sepolia does not currently expose wstETH reserve; use WETH stand-in.
WSTETH_ADDRESS=0x4200000000000000000000000000000000000006
WETH_ADDRESS=0x4200000000000000000000000000000000000006
USDC_ADDRESS=0xba50Cd2A20f6DA35D788639E581bca8d0B5d4D5f
USDC_DECIMALS=6
AAVE_POOL_ADDRESS=0x8bAB6d1b75f19e9eD9fCe8b9BD338844fF79aE27
DEX_ROUTER_ADDRESS=0x8bAB6d1b75f19e9eD9fCe8b9BD338844fF79aE27

# Quote API
ZEROX_API_URL=https://base-sepolia.api.0x.org/swap/allowance-holder/quote
ZEROX_API_KEY=

# Local persistence
RUN_LOG_PATH=./data/runs-sepolia-demo.ndjson
SNAPSHOT_PATH=./data/wsteth-snapshots-sepolia-demo.json
SWAP_COST_USD_ESTIMATE=0

# Runtime provenance tags
AGENT_VERSION=0.1.0
AUTOPILOT_VERSION=manual
AUTOPILOT_MODEL_ID=unspecified
AUTOPILOT_POLICY_VERSION=1
AUTOPILOT_COMMIT_SHA=unknown

# Dashboard telemetry (optional, no-ops if unset)
DASHBOARD_INGEST_URL=
INGEST_SECRET=
