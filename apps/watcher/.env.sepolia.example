# Base Sepolia demo profile (copy to .env.sepolia.local)
BASE_RPC_URL=https://base-sepolia-rpc.publicnode.com
CHAIN_ID=84532
ALLOW_TESTNET=true

USDC_ADDRESS=0xba50Cd2A20f6DA35D788639E581bca8d0B5d4D5f
USDC_DECIMALS=6

# Match apps/agent/.env.sepolia.local
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
COMPUTE_BILLING_MODE=escrow

# Conway credits (used only when COMPUTE_BILLING_MODE=conway)
CONWAY_API_BASE_URL=
CONWAY_API_KEY=
CONWAY_CREDITS_BALANCE_PATH=/v1/credits/balance
CONWAY_PAYER_ADDRESS=
CONWAY_FALLBACK_TO_ESCROW_ON_ERROR=true

WATCH_INTERVAL_SECONDS=300
WATCH_FAILURE_THRESHOLD=3
WATCH_LOW_BALANCE_GRACE_CHECKS=0
ESCROW_MIN_BALANCE_USDC=0
CONWAY_MIN_CREDITS_BALANCE_USDC=10
CONWAY_MIN_PAYER_BALANCE_USDC=5
WATCH_LOW_CREDITS_GRACE_CHECKS=0
WATCH_LOW_PAYER_GRACE_CHECKS=0
SHUTDOWN_COMMAND=echo "demo: stop agent manually"

# Autopilot controls
AUTOPILOT_POLICY_PATH=../../autonomy/policy.yaml
AUTOPILOT_STATE_PATH=./data/autopilot-state-sepolia.json
AUTOPILOT_EMERGENCY_STOP=false
AUTOPILOT_REQUIRE_HUMAN_APPROVAL=false
AUTOPILOT_TIMELOCK_HOURS=24
AUTOPILOT_APPROVAL_FILE=../../autonomy/approval.json
AUTOPILOT_PHASE=1
AUTOPILOT_RUN_VERIFICATION=false
AUTOPILOT_VERIFY_PROVENANCE=false
AUTOPILOT_POLICY_GATE_STRICT_DIFF_SOURCE=true
AUTOPILOT_PROVENANCE_REQUIRE_SIGNATURE=false

# Pull request automation
AUTOPILOT_PR_MODE=draft
AUTOPILOT_PR_BASE=main
AUTOPILOT_PR_REMOTE=origin
AUTOPILOT_GITHUB_REPOSITORY=owner/repo

# Run logs (match demo file in agent profile)
RUN_LOG_PATH=../agent/data/runs-sepolia-demo.ndjson
AUTOPILOT_BASELINE_RUN_LOG_PATH=../agent/data/runs-sepolia-demo.ndjson
AUTOPILOT_CANDIDATE_RUN_LOG_PATH=
AUTOPILOT_CANDIDATE_REPLAY_OUTPUT_PATH=../../autonomy/reports/replay-candidate.ndjson
AUTOPILOT_REPLAY_CANDIDATE_COMMAND=
AUTOPILOT_REPLAY_REPORT_PATH=../../autonomy/reports/replay.json
AUTOPILOT_BASELINE_ENV_PATH=../agent/.env.sepolia.example
AUTOPILOT_CANDIDATE_ENV_PATH=../agent/.env.sepolia.example
AUTOPILOT_VERIFY_REPORT_PATH=../../autonomy/reports/verification.json

# Deploy command hooks
AUTOPILOT_DEPLOY_STAGE=shadow_canary
AUTOPILOT_DEPLOY_PROMOTE_TO_LIVE_COMMAND=
AUTOPILOT_DEPLOY_PROMOTE_TO_PROD_COMMAND=
AUTOPILOT_DEPLOY_ROLLBACK_COMMAND=
AUTOPILOT_DEPLOY_REPORT_PATH=../../autonomy/reports/deploy-decision.json

# Provenance verify strictness
AUTOPILOT_EXPECTED_COMMIT_SHA=
AUTOPILOT_SIGNING_PRIVATE_KEY_PEM=
AUTOPILOT_SIGNING_PUBLIC_KEY_PEM=

# Champion scaffold outputs
AUTOPILOT_CHAMPION_STATE_PATH=./data/champions/state.json
AUTOPILOT_CHAMPION_PROVENANCE_DIR=./data/champions/provenance
AUTOPILOT_CHAMPION_REGISTRY_ADDRESS=
AUTOPILOT_CHAMPION_SUBMITTER_ADDRESS=

# Dashboard telemetry (optional, no-ops if unset)
DASHBOARD_INGEST_URL=
INGEST_SECRET=
